# מכסת אחסון מדיה — הגדרות התראה.
#
# הכתיב ‎: "${X:=y}"‎ נותן ברירת מחדל בלי לדרוס ערך שהועבר מבחוץ,
# כך שאפשר לבדוק ידנית:  sudo QUOTA_WARN_PCT=70 /opt/chatwoot/scripts/storage-quota-alert.sh

# 0 = הרצה יבשה (מדפיס מה היה נשלח, לא שולח כלום). 1 = שליחה בפועל.
: "${SEND:=0}"

# הקישור שהלקוח מקבל כדי לשדרג מנוי
: "${UPGRADE_URL:=}"

# תמחור: עד BASE כלול, ואז STEP_PRICE ₪ לכל STEP_GB נוספים
: "${QUOTA_BASE_GB:=10}"
: "${QUOTA_STEP_GB:=10}"
: "${QUOTA_STEP_PRICE:=30}"
: "${QUOTA_WARN_PCT:=80}"

# קצב התזכורות. לא שולחים בקצב קבוע אלא רק כשמשהו השתנה: אזהרה חוזרת
# רק אם הצריכה טיפסה עוד QUOTA_WARN_GROWTH_PCT מהמכסה ועברו
# QUOTA_WARN_EVERY_DAYS; חריגה חוזרת אחרי QUOTA_OVER_EVERY_DAYS אם היא
# גדלה, או מיד כשנכנסים למדרגת חיוב חדשה.
: "${QUOTA_WARN_EVERY_DAYS:=21}"
: "${QUOTA_OVER_EVERY_DAYS:=14}"
: "${QUOTA_WARN_GROWTH_PCT:=5}"

# שם השולח שהלקוח רואה בראש המייל, במקום הכתובת הגולמית
: "${QUOTA_FROM_NAME:=אחיה אוטומציה}"

# איפה נשמר זיכרון התזכורות. חייב להיות על המארח — /app/tmp בקונטיינר
# נמחק בכל בנייה מחדש של Chatwoot.
: "${STATE_HOST:=/opt/chatwoot/scripts/storage-quota-state.json}"

# התראת WhatsApp לאחיה (ריק = לא נשלח)
: "${WAHA_URL:=}"
: "${WAHA_API_KEY:=}"
: "${WAHA_SESSION:=default}"
: "${ALERT_CHAT_ID:=}"
